# Server Configuration
PORT=8000
HOST=127.0.0.1
DEBUG=True

# File Upload Settings
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,xlsx

# Database Settings
DATABASE_PATH=data/app.db

# Optional AI / LLM Configuration for Claim Extraction
# If not provided, the system automatically uses the built-in high-precision deterministic rule-based extractor
GEMINI_API_KEY=
# OPENAI_API_KEY=
LLM_PROVIDER=none
